# Set a unique random value of at least 32 bytes before production deployment.
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploying
NODE_ENV=development
PORT=8000
# Password-reset email via Resend (leave unset until a verified sender is configured).
# RESEND_API_KEY=re_...
# PASSWORD_RESET_FROM=BilaForm <accounts@example.com>
# PUBLIC_APP_URL=https://merab45.github.io/BilaForm-Website/
# Optional: set one exact trusted origin only when the frontend is hosted elsewhere.
# CORS_ORIGIN=https://your-frontend.example
